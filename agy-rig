def cmd_scan():
    print(f"\n  {Color.CYAN}================================================================{Color.RESET}")
    print(f"  {Color.BOLD}{Color.CYAN}>> SCANNING ANTIGRAVITY ECOSYSTEM CREDENTIALS{Color.RESET}")
    print(f"  {Color.CYAN}================================================================{Color.RESET}\n")

    found_sources = []

    # 1. System store
    print(f"  {Color.CYAN}[1/3] Checking system credential store...{Color.RESET}")
    cred = CredentialStore.read()
    if cred:
        email = extract_email(cred)
        print(f"        {Color.GREEN}[OK] Active credential found in system store{Color.RESET}")
        print(f"             Email: {Color.CYAN}{email or '(unknown)'}{Color.RESET}")
        found_sources.append({"source": "system_store", "email": email, "credential": cred})
    else:
        print(f"        {Color.GRAY}[--] No credentials found in system store.{Color.RESET}")

    # 2. Jetski state (AGY CLI)
    print(f"  {Color.CYAN}[2/3] Checking Antigravity CLI jetski state...{Color.RESET}")
    jetski_path = os.path.join(HOME, ".gemini", "antigravity-cli", "jetski_state.pbtxt")
    if os.path.exists(jetski_path):
        try:
            with open(jetski_path, "r", encoding="utf-8", errors="ignore") as fp:
                content = fp.read()
            refresh_match = re.search(r'refresh_token:\s*"([^"]+)"', content)
            access_match = re.search(r'access_token:\s*"([^"]+)"', content)
            if refresh_match or access_match:
                tok_obj = {
                    "token": {
                        "access_token": access_match.group(1) if access_match else "",
                        "refresh_token": refresh_match.group(1) if refresh_match else "",
                        "token_type": "Bearer"
                    },
                    "auth_method": "oauth"
                }
                tok_str = json.dumps(tok_obj)
                email = extract_email(tok_str)
                print(f"        {Color.GREEN}[OK] CLI tokens found in jetski_state.pbtxt{Color.RESET}")
                print(f"             Email: {Color.CYAN}{email or '(unknown)'}{Color.RESET}")
                found_sources.append({"source": "jetski_state", "email": email, "credential": tok_str})
            else:
                print(f"        {Color.GRAY}[--] jetski_state.pbtxt exists but contains no OAuth tokens.{Color.RESET}")
        except Exception as e:
            print(f"        {Color.YELLOW}[!] Failed reading jetski state: {e}{Color.RESET}")
    else:
        print(f"        {Color.GRAY}[--] jetski_state.pbtxt not found.{Color.RESET}")

    # 3. Existing profiles
    print(f"  {Color.CYAN}[3/3] Checking isolated parallel profile storage...{Color.RESET}")
    saved = list_saved_accounts()
    print(f"        Found {Color.GREEN}{len(saved)}{Color.RESET} saved profiles in AGY RIG.")

    print(f"\n  {Color.GREEN}================================================================{Color.RESET}")
    print(f"  {Color.BOLD}{Color.GREEN}[OK] Credential scan completed successfully.{Color.RESET}")
    print(f"  {Color.GREEN}================================================================{Color.RESET}\n")

