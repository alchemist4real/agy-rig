            subprocess.run(["git", "add", "-A"], cwd=temp_dir, capture_output=True, check=True)
            subprocess.run(["git", "commit", "-m", f"chore(vault): update encrypted vault [{datetime.now().strftime('%Y-%m-%d %H:%M:%S')}]"], cwd=temp_dir, capture_output=True, check=True)

            remote_url = subprocess.run(["gh", "repo", "view", target_repo, "--json", "url", "-q", ".url"], capture_output=True, text=True).stdout.strip() + ".git"
            subprocess.run(["git", "remote", "add", "origin", remote_url], cwd=temp_dir, capture_output=True, check=True)
            subprocess.run(["git", "push", "-f", "origin", "main"], cwd=temp_dir, capture_output=True, check=True)

            print(f"\n  {Color.GREEN}================================================================{Color.RESET}")
            print(f"  {Color.BOLD}{Color.GREEN}[OK] ENCRYPTED VAULT BACKED UP TO GITHUB SUCCESSFULLY{Color.RESET}")
            print(f"  {Color.GREEN}================================================================{Color.RESET}")
