class AgyCrypto:
    @staticmethod
    def derive_keys(passphrase: str, salt: bytes):
        derived = hashlib.pbkdf2_hmac("sha1", passphrase.encode("utf-8"), salt, 100000, 48)
        aes_key = derived[:32]
        iv = derived[32:48]
        return aes_key, iv

    @classmethod
    def encrypt_vault(cls, plaintext: str, passphrase: str) -> str:
        salt = os.urandom(16)
        aes_key, iv = cls.derive_keys(passphrase, salt)
        plain_bytes = plaintext.encode("utf-8")

        try:
            from cryptography.hazmat.primitives.ciphers import Cipher, algorithms, modes
            from cryptography.hazmat.primitives import padding
            padder = padding.PKCS7(128).padder()
            padded = padder.update(plain_bytes) + padder.finalize()
            cipher = Cipher(algorithms.AES(aes_key), modes.CBC(iv))
            encryptor = cipher.encryptor()
            cipher_bytes = encryptor.update(padded) + encryptor.finalize()
        except ImportError:
            # Fallback to openssl CLI
            cmd = ["openssl", "enc", "-aes-256-cbc", "-K", aes_key.hex(), "-iv", iv.hex()]
            proc = subprocess.run(cmd, input=plain_bytes, capture_output=True, check=True)
            cipher_bytes = proc.stdout

        tag = hmac.new(aes_key, cipher_bytes, hashlib.sha256).digest()
        raw = salt + iv + tag + cipher_bytes
        return base64.b64encode(raw).decode("ascii")

    @classmethod
    def decrypt_vault(cls, enc_b64: str, passphrase: str) -> str:
        raw = base64.b64decode(enc_b64.strip())
        if len(raw) < (16 + 16 + 32):
            raise ValueError("Vault payload is truncated or invalid.")

        salt = raw[:16]
        iv = raw[16:32]
        expected_tag = raw[32:64]
        cipher_bytes = raw[64:]

        aes_key, _ = cls.derive_keys(passphrase, salt)
        computed_tag = hmac.new(aes_key, cipher_bytes, hashlib.sha256).digest()

        if not hmac.compare_digest(computed_tag, expected_tag):
            raise ValueError("HMAC verification failed: corrupted vault or incorrect passphrase.")

        try:
            from cryptography.hazmat.primitives.ciphers import Cipher, algorithms, modes
            from cryptography.hazmat.primitives import padding
            cipher = Cipher(algorithms.AES(aes_key), modes.CBC(iv))
            decryptor = cipher.decryptor()
            padded = decryptor.update(cipher_bytes) + decryptor.finalize()
            unpadder = padding.PKCS7(128).unpadder()
            plain = unpadder.update(padded) + unpadder.finalize()
            return plain.decode("utf-8")
        except ImportError:
            cmd = ["openssl", "enc", "-d", "-aes-256-cbc", "-K", aes_key.hex(), "-iv", iv.hex()]
            proc = subprocess.run(cmd, input=cipher_bytes, capture_output=True, check=True)
            return proc.stdout.decode("utf-8")

