def fetch_live_quota():
    cli = find_agy_cli()
    q = {
        "success": False,
        "gemini_5h": 0.0,
        "gemini_5h_reset": "",
        "gemini_wk": 0.0,
        "gemini_wk_reset": "",
        "claude_5h": 0.0,
        "claude_5h_reset": "",
        "claude_wk": 0.0,
        "claude_wk_reset": "",
        "credits": 0,
        "upgrade_uri": "",
        "timestamp": datetime.now().strftime("%Y-%m-%d %H:%M:%S")
    }
    try:
        u_proc = subprocess.run([cli, "-p", "/usage", "--output-format", "json"], capture_output=True, text=True, timeout=8)
        if u_proc.returncode == 0 and u_proc.stdout.strip():
            u = json.loads(u_proc.stdout.strip())
            groups = u.get("command", {}).get("data", {}).get("groups", []) or u.get("groups", [])
            for g in groups:
                g_name = (g.get("name") or "").lower()
                for b in g.get("buckets", []):
                    w = b.get("window", "")
                    rem = float(b.get("remaining_fraction", 0.0))
                    rst = b.get("reset_time", "")
                    if "gemini" in g_name:
                        if w == "5h":
                            q["gemini_5h"] = rem
                            q["gemini_5h_reset"] = rst
                        elif w == "weekly":
                            q["gemini_wk"] = rem
                            q["gemini_wk_reset"] = rst
                    elif "claude" in g_name:
                        if w == "5h":
                            q["claude_5h"] = rem
                            q["claude_5h_reset"] = rst
                        elif w == "weekly":
                            q["claude_wk"] = rem
                            q["claude_wk_reset"] = rst
            q["success"] = True
    except Exception:
        pass

    try:
        c_proc = subprocess.run([cli, "-p", "/credits", "--output-format", "json"], capture_output=True, text=True, timeout=8)
        if c_proc.returncode == 0 and c_proc.stdout.strip():
            c = json.loads(c_proc.stdout.strip())
            c_data = c.get("command", {}).get("data", {}) or c
            if c_data.get("remaining_credits") is not None:
                q["credits"] = int(c_data["remaining_credits"])
            if c_data.get("upgrade_uri"):
                q["upgrade_uri"] = c_data["upgrade_uri"]
    except Exception:
        pass

    return q

def format_countdown(iso_str: str) -> str:
    if not iso_str:
        return "--"
    try:
        dt = datetime.fromisoformat(iso_str.replace("Z", "+00:00"))
        now = datetime.now(timezone.utc)
        diff = int((dt - now).total_seconds())
        if diff <= 0:
            return "Ready"
        h = diff // 3600
        m = (diff % 3600) // 60
        if h >= 24:
            return f"{h // 24}d {h % 24}h"
        elif h > 0:
            return f"{h}h {m}m"
        else:
            return f"{m}m"
    except Exception:
        return "--"

def progress_bar(val: float, width: int = 20) -> str:
    pct = max(0.0, min(1.0, val))
    filled = int(round(pct * width))
    empty = width - filled
    return "=" * filled + "-" * empty

