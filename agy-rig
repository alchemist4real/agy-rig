def get_running_antigravity_processes():
    """
    Returns a list of dicts:
    [{ 'pid': 1234, 'is_parallel': True, 'profile_name': 'alt1', 'cmd': '...' }]
    """
    procs = []
    if sys.platform in ["darwin", "linux"]:
        try:
            res = subprocess.run(["ps", "-eo", "pid,command"], capture_output=True, text=True)
            for line in res.stdout.splitlines():
                if "Antigravity" in line or "antigravity" in line:
                    if "--type=" in line:
                        continue  # Skip Chromium child helper/renderer processes
                    parts = line.strip().split(None, 1)
                    if len(parts) < 2:
                        continue
                    pid = int(parts[0])
                    cmd = parts[1]
                    m = re.search(r"profiles[/\\]([^/\"]+)", cmd)
                    is_parallel = bool(m)
                    prof_name = m.group(1).lower() if m else "primary"
                    procs.append({
                        "pid": pid,
                        "is_parallel": is_parallel,
                        "profile_name": prof_name,
                        "cmd": cmd
                    })
        except Exception:
            pass
    elif sys.platform == "win32":
        ps_cmd = 'Get-CimInstance Win32_Process -Filter "Name like \'Antigravity%\'" | Where-Object { $_.CommandLine -notmatch "--type=" } | Select-Object ProcessId, CommandLine | ConvertTo-Json'
        try:
            res = subprocess.run(["powershell", "-NoProfile", "-Command", ps_cmd], capture_output=True, text=True)
            data = json.loads(res.stdout.strip()) if res.stdout.strip() else []
            if isinstance(data, dict):
                data = [data]
            for p in data:
                cmd = p.get("CommandLine") or ""
                m = re.search(r"profiles[/\\]([^/\"\s]+)", cmd)
                is_parallel = bool(m)
                prof_name = m.group(1).lower() if m else "primary"
                procs.append({
                    "pid": p.get("ProcessId"),
                    "is_parallel": is_parallel,
                    "profile_name": prof_name,
                    "cmd": cmd
                })
        except Exception:
            pass
    return procs

def stop_primary_processes():
    for p in get_running_antigravity_processes():
        if not p["is_parallel"]:
            try:
                os.kill(p["pid"], 9)
            except Exception:
                pass

def focus_process_window(profile_name: str) -> bool:
    clean = profile_name.strip().lower()
    if sys.platform == "darwin":
        try:
            subprocess.run(["osascript", "-e", 'tell application "Antigravity" to activate'], check=True)
            return True
        except Exception:
            return False
    elif sys.platform.startswith("linux"):
        # Try wmctrl then xdotool
        try:
            subprocess.run(["wmctrl", "-x", "-a", "antigravity"], capture_output=True, check=True)
            return True
        except Exception:
            try:
                subprocess.run(["xdotool", "search", "--class", "antigravity", "windowactivate"], capture_output=True, check=True)
                return True
            except Exception:
                return False
    elif sys.platform == "win32":
        try:
            import ctypes
            user32 = ctypes.windll.user32
            procs = get_running_antigravity_processes()
            target = None
            for p in procs:
                if p["is_parallel"] and p["profile_name"] == clean:
                    target = p
                    break
                elif not p["is_parallel"] and clean in ["primary", "default", "main", "(primary)"]:
                    target = p
                    break
            if target:
                found_hwnd = []
                def enum_proc(hwnd, lparam):
                    pid = ctypes.wintypes.DWORD()
                    user32.GetWindowThreadProcessId(hwnd, ctypes.byref(pid))
                    if pid.value == target["pid"] and user32.IsWindowVisible(hwnd):
                        found_hwnd.append(hwnd)
                        return False
                    return True
                WNDENUMPROC = ctypes.WINFUNCTYPE(ctypes.wintypes.BOOL, ctypes.wintypes.HWND, ctypes.wintypes.LPARAM)
                user32.EnumWindows(WNDENUMPROC(enum_proc), 0)
                if found_hwnd:
                    h = found_hwnd[0]
                    user32.ShowWindowAsync(h, 9)  # SW_RESTORE
                    user32.SetForegroundWindow(h)
                    return True
        except Exception:
            pass
    return False

