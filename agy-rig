def cmd_parallel(subcmd: str, name: str):
    if subcmd in ["list", "ls"] or not subcmd:
        procs = get_running_antigravity_processes()
        print(f"\n  {Color.CYAN}--------------------------------------------------{Color.RESET}")
        print(f"  {Color.BOLD}{Color.CYAN}>> Active Parallel Antigravity Sessions{Color.RESET}")
        print(f"  {Color.CYAN}--------------------------------------------------{Color.RESET}")
        parallels = [p for p in procs if p["is_parallel"]]
        if not parallels:
            print(f"  {Color.GRAY}No parallel instances currently running.{Color.RESET}")
            print(f"  {Color.GRAY}Launch with: agy-rig parallel launch <name>{Color.RESET}\n")
            return
        for idx, p in enumerate(parallels, 1):
            print(f"  {idx}. {Color.BOLD}{p['profile_name'].upper()}{Color.RESET} (PID: {p['pid']})")
        print()
    elif subcmd in ["launch", "start"]:
        if not name:
            print(f"  {Color.RED}[ERROR] Specify profile name to launch.{Color.RESET}")
            return
        clean = name.strip().lower()
        acc_file = os.path.join(ACCOUNTS_DIR, f"{clean}.json")
        if not os.path.exists(acc_file):
            acc_file = os.path.join(ACCOUNTS_DIR, f"{clean}.dat")
        if not os.path.exists(acc_file):
            print(f"  {Color.RED}[ERROR] Profile '{clean}' not found. Run 'agy-rig list'.{Color.RESET}")
            return

        with open(acc_file, "r", encoding="utf-8") as fp:
            data = json.load(fp)

        target_cred = data.get("credential", "")
        target_user = data.get("user", "antigravity")

        prof_dir = os.path.join(PROFILES_DIR, clean, "userdata")
        os.makedirs(prof_dir, exist_ok=True)
        init_file = os.path.join(prof_dir, "app_storage.json")
        if not os.path.exists(init_file):
            with open(init_file, "w", encoding="utf-8") as fp:
                json.dump({"ide-install-wizard-shown": "true"}, fp)

        exe = find_antigravity_bin()
        cur_cred = CredentialStore.read()
        cur_user = "antigravity"

        print(f"  {Color.YELLOW}>> Injecting credentials for '{clean}' ({data.get('email')})...{Color.RESET}")
        CredentialStore.write(target_cred, target_user)

        cmd = [exe, f"--user-data-dir={prof_dir}"]
        proc = subprocess.Popen(cmd, start_new_session=True)
        print(f"\n  {Color.GREEN}[OK] Parallel session for '{clean}' launched successfully.{Color.RESET}")

        # Restore credentials after parallel session authenticates
        if cur_cred and cur_cred != target_cred:
            print(f"  {Color.YELLOW}>> Synchronizing authentication with parallel instance...{Color.RESET}")
            time.sleep(12)
            CredentialStore.write(cur_cred, cur_user)
            print(f"  {Color.GRAY}[OK] Primary credentials restored to active state.{Color.RESET}\n")
    elif subcmd in ["focus", "switch"]:
        if not name:
            print(f"  {Color.RED}[ERROR] Specify profile name to focus.{Color.RESET}")
            return
        clean = name.strip().lower()
        if focus_process_window(clean):
            print(f"  {Color.GREEN}[OK] Focused parallel session for '{clean}'.{Color.RESET}")
        else:
            print(f"  {Color.YELLOW}[!] Could not focus window automatically. Launching if needed...{Color.RESET}")
            cmd_parallel("launch", clean)
    elif subcmd in ["close", "kill"]:
        clean = (name or "").strip().lower()
        procs = get_running_antigravity_processes()
        targets = [p for p in procs if p["is_parallel"] and (clean == "all" or p["profile_name"] == clean)]
        if not targets:
            print(f"  {Color.YELLOW}[WARN] No matching parallel session found running.{Color.RESET}")
            return
        for t in targets:
            try:
                os.kill(t["pid"], 9)
                print(f"  {Color.GREEN}[OK] Terminated session: {t['profile_name']} (PID: {t['pid']}){Color.RESET}")
            except Exception as e:
                print(f"  {Color.RED}[!] Failed terminating PID {t['pid']}: {e}{Color.RESET}")

