def save_account(name: str, cred_blob: str, email: str = ""):
    clean_name = name.strip().lower()
    if not email:
        email = extract_email(cred_blob) or "(not detected)"
    data = {
        "name": clean_name,
        "user": "antigravity",
        "email": email,
        "credential": cred_blob,
        "saved_at": datetime.now().strftime("%Y-%m-%d %H:%M:%S")
    }
    if sys.platform == "win32":
        enc_data = dict(data)
        enc_data["credential"] = base64.b64encode(dpapi_encrypt(cred_blob.encode("utf-8"))).decode("ascii")
        target = os.path.join(ACCOUNTS_DIR, f"{clean_name}.dat")
        with open(target, "w", encoding="utf-8") as fp:
            json.dump(enc_data, fp, indent=2)
    else:
        target = os.path.join(ACCOUNTS_DIR, f"{clean_name}.json")
        with open(target, "w", encoding="utf-8") as fp:
            json.dump(data, fp, indent=2)
    set_active_account_name(clean_name)
    return data

