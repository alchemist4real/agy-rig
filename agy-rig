class OAuthCallbackServer:
    def __init__(self):
        self.code = None
        self.error = None

    def start_and_wait(self, timeout: int = 180):
        auth_code_holder = {"code": None, "error": None}

        class Handler(BaseHTTPRequestHandler):
            def do_GET(self):
                query = urllib.parse.urlparse(self.path).query
                params = urllib.parse.parse_qs(query)
                if "code" in params:
                    auth_code_holder["code"] = params["code"][0]
                if "error" in params:
                    auth_code_holder["error"] = params["error"][0]

                self.send_response(200)
                self.send_header("Content-Type", "text/html; charset=utf-8")
                self.end_headers()
                html = (
                    "<html><body style='font-family:monospace;text-align:center;padding:50px;"
                    "background:#161408;color:#FFE633;'><h2>LOGIN SUCCESSFUL!</h2>"
                    "<p style='color:#B3A220;'>Your Google account has been connected to AGY RIG.<br>"
                    "You may close this tab and return to the terminal.</p></body></html>"
                )
                self.wfile.write(html.encode("utf-8"))

            def log_message(self, format, *args):
                pass

        sock = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
        sock.bind(("127.0.0.1", 0))
        port = sock.getsockname()[1]
        sock.close()

        server = HTTPServer(("127.0.0.1", port), Handler)
        server.timeout = timeout
        redirect_uri = f"http://127.0.0.1:{port}/"

        # PKCE parameters
        verifier_bytes = os.urandom(32)
        verifier = base64.urlsafe_b64encode(verifier_bytes).decode("ascii").rstrip("=")
        challenge = base64.urlsafe_b64encode(hashlib.sha256(verifier.encode("ascii")).digest()).decode("ascii").rstrip("=")

        params = {
            "client_id": CLIENT_ID,
            "redirect_uri": redirect_uri,
            "response_type": "code",
            "scope": "openid email profile",
            "code_challenge": challenge,
            "code_challenge_method": "S256",
            "prompt": "select_account"
        }
        auth_url = f"https://accounts.google.com/o/oauth2/v2/auth?{urllib.parse.urlencode(params)}"

        print(f"\n  {Color.YELLOW}>> Opening browser for Google sign-in...{Color.RESET}")
        print(f"     {Color.GREEN}(Primary Antigravity remains running uninterrupted){Color.RESET}")
        print(f"     {Color.GRAY}Please complete sign-in in your browser...{Color.RESET}")

        class CustomHandler(BaseHTTPRequestHandler):
            def do_GET(self):
                if self.path.startswith("/favicon"):
                    self.send_response(204)
                    self.end_headers()
                    return
                query = urllib.parse.urlparse(self.path).query
                qs = urllib.parse.parse_qs(query)
                if "code" in qs or "error" in qs:
                    auth_code_holder["code"] = qs.get("code", [None])[0]
                    auth_code_holder["error"] = qs.get("error", [None])[0]
                self.send_response(200)
                self.send_header("Content-Type", "text/html")
                self.end_headers()
                html = (
                    "<html><body style='font-family:monospace;text-align:center;padding:50px;"
                    "background:#161408;color:#FFE633;'><h2>LOGIN SUCCESSFUL!</h2>"
                    "<p style='color:#B3A220;'>Your Google account has been connected to AGY RIG.<br>"
                    "You may close this tab and return to your terminal.</p></body></html>"
                )
                self.wfile.write(html.encode("utf-8"))

            def log_message(self, format, *args):
                pass

        server.RequestHandlerClass = CustomHandler

        if sys.platform == "darwin":
            subprocess.run(["open", auth_url])
        elif sys.platform.startswith("linux"):
            subprocess.run(["xdg-open", auth_url])
        elif sys.platform == "win32":
            os.startfile(auth_url)

        deadline = time.time() + timeout
        server.timeout = 1.0
        while time.time() < deadline and not auth_code_holder["code"] and not auth_code_holder["error"]:
            server.handle_request()
        server.server_close()

        if not auth_code_holder["code"]:
            return {"success": False, "error": auth_code_holder["error"] or "TIMEOUT"}

        # Token exchange
        token_data = {
            "client_id": CLIENT_ID,
            "code": auth_code_holder["code"],
            "code_verifier": verifier,
            "grant_type": "authorization_code",
            "redirect_uri": redirect_uri
        }
        req = urllib.request.Request(
            "https://oauth2.googleapis.com/token",
            data=urllib.parse.urlencode(token_data).encode("utf-8"),
            headers={"Content-Type": "application/x-www-form-urlencoded"}
        )
        try:
            with urllib.request.urlopen(req, timeout=10) as resp:
                token_resp = json.loads(resp.read().decode("utf-8"))
                cred_obj = {
                    "token": {
                        "access_token": token_resp.get("access_token"),
                        "token_type": token_resp.get("token_type", "Bearer"),
                        "refresh_token": token_resp.get("refresh_token"),
                        "expiry": datetime.fromtimestamp(time.time() + token_resp.get("expires_in", 3600), timezone.utc).strftime("%Y-%m-%dT%H:%M:%S.000000Z")
                    },
                    "auth_method": "oauth",
                    "id_token": token_resp.get("id_token")
                }
                cred_str = json.dumps(cred_obj, indent=2)
                email = extract_email(cred_str)
                return {"success": True, "email": email, "credential": cred_str}
        except Exception as e:
            return {"success": False, "error": f"TOKEN_EXCHANGE_FAILED: {e}"}

