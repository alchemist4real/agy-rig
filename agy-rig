def list_saved_accounts():
    accounts = []
    if not os.path.exists(ACCOUNTS_DIR):
        return accounts
    for fname in sorted(os.listdir(ACCOUNTS_DIR)):
        if fname.endswith(".json") or (fname.endswith(".dat") and not fname.endswith("_mcp.dat")):
            fpath = os.path.join(ACCOUNTS_DIR, fname)
            try:
                with open(fpath, "r", encoding="utf-8-sig") as fp:
                    data = json.load(fp)
                    if fname.endswith(".dat") and sys.platform == "win32":
                        try:
                            raw_b64 = data.get("credential", "")
                            plain_bytes = dpapi_decrypt(base64.b64decode(raw_b64))
                            if plain_bytes:
                                data["credential"] = plain_bytes.decode("utf-8", errors="replace")
                        except Exception:
                            pass
                    accounts.append(data)
            except Exception:
                pass
    return accounts

