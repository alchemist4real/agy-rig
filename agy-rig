def extract_email(cred_str: str) -> str:
    if not cred_str:
        return ""
    try:
        data = json.loads(cred_str)
        if "email" in data and data["email"]:
            return data["email"]
        id_token = data.get("id_token") or ((data.get("token") or {}).get("id_token"))
        if id_token and "." in id_token:
            parts = id_token.split(".")
            if len(parts) >= 2:
                payload = parts[1]
                payload += "=" * ((4 - len(payload) % 4) % 4)
                dec = base64.urlsafe_b64decode(payload)
                jwt_obj = json.loads(dec.decode("utf-8"))
                if "email" in jwt_obj:
                    return jwt_obj["email"]
        access_token = data.get("access_token") or ((data.get("token") or {}).get("access_token"))
        if access_token:
            req = urllib.request.Request(f"https://oauth2.googleapis.com/tokeninfo?access_token={access_token}")
            with urllib.request.urlopen(req, timeout=3) as resp:
                info = json.loads(resp.read().decode("utf-8"))
                if "email" in info:
                    return info["email"]
    except Exception:
        pass
    return ""

