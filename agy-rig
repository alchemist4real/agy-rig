if sys.platform == "win32":
    import ctypes
    from ctypes import wintypes

    class FILETIME(ctypes.Structure):
        _fields_ = [("dwLowDateTime", wintypes.DWORD), ("dwHighDateTime", wintypes.DWORD)]

    class CREDENTIALW(ctypes.Structure):
        _fields_ = [
            ("Flags", wintypes.DWORD),
            ("Type", wintypes.DWORD),
            ("TargetName", wintypes.LPWSTR),
            ("Comment", wintypes.LPWSTR),
            ("LastWritten", FILETIME),
            ("CredentialBlobSize", wintypes.DWORD),
            ("CredentialBlob", ctypes.POINTER(ctypes.c_char)),
            ("Persist", wintypes.DWORD),
            ("AttributeCount", wintypes.DWORD),
            ("Attributes", ctypes.c_void_p),
            ("TargetAlias", wintypes.LPWSTR),
            ("UserName", wintypes.LPWSTR),
        ]

    PCREDENTIALW = ctypes.POINTER(CREDENTIALW)
    advapi32 = ctypes.windll.advapi32
    CredReadW = advapi32.CredReadW
    CredReadW.argtypes = [wintypes.LPCWSTR, wintypes.DWORD, wintypes.DWORD, ctypes.POINTER(PCREDENTIALW)]
    CredReadW.restype = wintypes.BOOL

    CredWriteW = advapi32.CredWriteW
    CredWriteW.argtypes = [PCREDENTIALW, wintypes.DWORD]
    CredWriteW.restype = wintypes.BOOL

    CredDeleteW = advapi32.CredDeleteW
    CredDeleteW.argtypes = [wintypes.LPCWSTR, wintypes.DWORD, wintypes.DWORD]
    CredDeleteW.restype = wintypes.BOOL

    CredFree = advapi32.CredFree
    CredFree.argtypes = [ctypes.c_void_p]
    CredFree.restype = None

    class DATA_BLOB(ctypes.Structure):
        _fields_ = [("cbData", wintypes.DWORD), ("pbData", ctypes.POINTER(ctypes.c_char))]

    crypt32 = ctypes.windll.crypt32

    def dpapi_encrypt(data: bytes) -> bytes:
        buf = ctypes.create_string_buffer(data)
        in_blob = DATA_BLOB(len(data), ctypes.cast(buf, ctypes.POINTER(ctypes.c_char)))
        out_blob = DATA_BLOB()
        if crypt32.CryptProtectData(ctypes.byref(in_blob), "Antigravity", None, None, None, 0, ctypes.byref(out_blob)):
            res = ctypes.string_at(out_blob.pbData, out_blob.cbData)
            ctypes.windll.kernel32.LocalFree(out_blob.pbData)
            return res
        return b""

    def dpapi_decrypt(data: bytes) -> bytes:
        buf = ctypes.create_string_buffer(data)
        in_blob = DATA_BLOB(len(data), ctypes.cast(buf, ctypes.POINTER(ctypes.c_char)))
        out_blob = DATA_BLOB()
        if crypt32.CryptUnprotectData(ctypes.byref(in_blob), None, None, None, None, 0, ctypes.byref(out_blob)):
            res = ctypes.string_at(out_blob.pbData, out_blob.cbData)
            ctypes.windll.kernel32.LocalFree(out_blob.pbData)
            return res
        return b""

class CredentialStore:
    """
    Cross-platform abstraction for secure token storage:
    - macOS: Apple Keychain Services
    - Linux: libsecret (Secret Service) with file fallback
    - Windows: Windows Credential Manager via native advapi32 ctypes (< 1ms)
    """

    @classmethod
    def read(cls) -> str:
        if sys.platform == "darwin":
            try:
                cmd = ["security", "find-generic-password", "-s", CRED_TARGET, "-w"]
                res = subprocess.run(cmd, capture_output=True, text=True)
                if res.returncode == 0 and res.stdout.strip():
                    return res.stdout.strip()
            except Exception:
                pass
        elif sys.platform.startswith("linux"):
            try:
                cmd = ["secret-tool", "lookup", "service", CRED_TARGET, "username", "antigravity"]
                res = subprocess.run(cmd, capture_output=True, text=True)
                if res.returncode == 0 and res.stdout.strip():
                    return res.stdout.strip()
            except Exception:
                pass
            # Linux fallback file
            f = os.path.join(HOME, ".gemini", "antigravity", "credentials.json")
            if os.path.exists(f):
                try:
                    with open(f, "r", encoding="utf-8") as fp:
                        return fp.read().strip()
                except Exception:
                    pass
        elif sys.platform == "win32":
            for target in [CRED_TARGET, "gemini:antigravity", "antigravity_google_oauth_credential"]:
                p = PCREDENTIALW()
                if CredReadW(target, 1, 0, ctypes.byref(p)):
                    try:
                        cred = p.contents
                        size = cred.CredentialBlobSize
                        if size > 0 and cred.CredentialBlob:
                            raw = ctypes.string_at(cred.CredentialBlob, size)
                            return raw.decode("utf-8", errors="replace")
                    finally:
                        CredFree(p)
        return ""

    @classmethod
    def write(cls, cred_blob: str, username: str = "antigravity") -> bool:
        if not cred_blob:
            return False
        if sys.platform == "darwin":
            try:
                cmd = ["security", "add-generic-password", "-U", "-s", CRED_TARGET, "-a", username, "-w", cred_blob]
                res = subprocess.run(cmd, capture_output=True)
                return res.returncode == 0
            except Exception:
                return False
        elif sys.platform.startswith("linux"):
            written = False
            try:
                cmd = ["secret-tool", "store", "--label=Antigravity", "service", CRED_TARGET, "username", username]
                res = subprocess.run(cmd, input=cred_blob.encode("utf-8"), capture_output=True)
                written = (res.returncode == 0)
            except Exception:
                pass
            # Always ensure fallback file is up to date on Linux
            f = os.path.join(HOME, ".gemini", "antigravity", "credentials.json")
            try:
                os.makedirs(os.path.dirname(f), exist_ok=True)
                with open(f, "w", encoding="utf-8") as fp:
                    fp.write(cred_blob)
                written = True
            except Exception:
                pass
            return written
        elif sys.platform == "win32":
            blob_bytes = cred_blob.encode("utf-8")
            buf = ctypes.create_string_buffer(blob_bytes)
            cred = CREDENTIALW()
            cred.Flags = 0
            cred.Type = 1  # CRED_TYPE_GENERIC
            cred.TargetName = CRED_TARGET
            cred.Comment = "Antigravity credentials"
            cred.UserName = username
            cred.CredentialBlobSize = len(blob_bytes)
            cred.CredentialBlob = ctypes.cast(buf, ctypes.POINTER(ctypes.c_char))
            cred.Persist = 2  # CRED_PERSIST_LOCAL_MACHINE
            cred.AttributeCount = 0
            cred.Attributes = None
            cred.TargetAlias = None
            return bool(CredWriteW(ctypes.byref(cred), 0))
        return False

