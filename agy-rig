                print(f"          Set AGY_VAULT_PASSPHRASE environment variable to authenticate.{Color.RESET}")
                return
            passphrase = getpass.getpass("  Enter Master Passphrase to decrypt vault: ")
        import tempfile
        import shutil
        temp_dir = tempfile.mkdtemp(prefix="agyrig-restore-")
        try:
            print(f"\n  {Color.CYAN}[1/3] Cloning vault from private repository '{target_repo}'...{Color.RESET}")
            clone_res = subprocess.run(["gh", "repo", "clone", target_repo, temp_dir, "--", "--depth", "1"], capture_output=True)
            vault_file = os.path.join(temp_dir, "vault.enc")
            if not os.path.exists(vault_file):
                print(f"  {Color.RED}[ERROR] vault.enc not found in repository '{target_repo}'.{Color.RESET}")
                return

            with open(vault_file, "r", encoding="utf-8") as fp:
                enc_data = fp.read()

            print(f"  {Color.CYAN}[2/3] Decrypting and verifying HMAC integrity...{Color.RESET}")
            plain_json = AgyCrypto.decrypt_vault(enc_data, passphrase)
            payload = json.loads(plain_json)

            print(f"  {Color.CYAN}[3/3] Restoring accounts to local AGY RIG store...{Color.RESET}")
            count = 0
            for acc in payload.get("accounts", []):
                save_account(acc["name"], acc["credential"], acc.get("email", ""))
                print(f"        {Color.GREEN}[+] Restored: {acc['name'].upper()} [{acc.get('email')}]{Color.RESET}")
                count += 1

            print(f"\n  {Color.GREEN}================================================================{Color.RESET}")
            print(f"  {Color.BOLD}{Color.GREEN}[OK] Successfully restored {count} account(s) from GitHub Vault.{Color.RESET}")
            print(f"  {Color.GREEN}================================================================{Color.RESET}\n")
        except Exception as e:
            print(f"  {Color.RED}[ERROR] Vault restore failed: {e}{Color.RESET}\n")
        finally:
            shutil.rmtree(temp_dir, ignore_errors=True)

def cmd_login():
    server = OAuthCallbackServer()
    res = server.start_and_wait()
    if res["success"]:
        email = res["email"]
        suggested = email.split("@")[0] if email else "account"
        print(f"\n  {Color.GREEN}[OK] Sign-in detected successfully.{Color.RESET}")
        print(f"       Email: {Color.CYAN}{email}{Color.RESET}")
        name = input(f"  Enter name for this account profile (default: '{suggested}'): ").strip() or suggested
        save_account(name, res["credential"], email)
        print(f"  {Color.GREEN}[OK] Account '{name}' ({email}) saved successfully.{Color.RESET}\n")
    else:
        print(f"\n  {Color.YELLOW}[WARN] Sign-in cancelled or failed: {res.get('error')}{Color.RESET}\n")

# ---------------------------------------------------------------------------
# Main Router
# ---------------------------------------------------------------------------

def main():
    args = sys.argv[1:]
    if not args:
        cmd_help()
        return

    cmd = args[0].lower()

    if cmd in ["help", "--help", "-h"]:
        cmd_help()
    elif cmd == "scan":
        cmd_scan()
    elif cmd in ["save", "add-active"]:
        name = args[1] if len(args) > 1 else ""
        if not name:
            print(f"  {Color.RED}[ERROR] Specify a name: agy-rig save <name>{Color.RESET}")
            return
        cred = CredentialStore.read()
        if not cred:
            print(f"  {Color.RED}[ERROR] No active credential found in system store.{Color.RESET}")
            return
        save_account(name, cred)
        print(f"  {Color.GREEN}[OK] Active credential saved as profile '{name}'.{Color.RESET}")
    elif cmd in ["use", "switch"]:
        cmd_use(args[1] if len(args) > 1 else "")
    elif cmd in ["parallel", "paralel", "p"]:
        subcmd = args[1].lower() if len(args) > 1 else "list"
        param = args[2] if len(args) > 2 else ""
        cmd_parallel(subcmd, param)
    elif cmd in ["profiles", "launch"]:
        if cmd == "profiles":
            cmd_parallel("list", "")
        else:
            cmd_parallel("launch", args[1] if len(args) > 1 else "")
    elif cmd == "vault":
        action = args[1].lower() if len(args) > 1 else ""
        repo = args[2] if len(args) > 2 else "agy-rig-vault"
        cmd_vault(action, repo)
    elif cmd in ["backup", "export"]:
        cmd_vault("backup", args[1] if len(args) > 1 else "agy-rig-vault")
    elif cmd in ["import", "restore"]:
        cmd_vault("import", args[1] if len(args) > 1 else "agy-rig-vault")
    elif cmd in ["list", "ls"]:
        cmd_list()
    elif cmd in ["quota", "credits"]:
        cmd_quota()
    elif cmd == "login":
        cmd_login()
    elif cmd in ["delete", "del", "rm"]:
        name = args[1].lower() if len(args) > 1 else ""
        if not name:
            print(f"  {Color.RED}[ERROR] Specify account name to delete.{Color.RESET}")
            return
        for ext in [".json", ".dat"]:
            f = os.path.join(ACCOUNTS_DIR, f"{name}{ext}")
            if os.path.exists(f):
                os.remove(f)
                print(f"  {Color.GREEN}[OK] Profile '{name}' deleted.{Color.RESET}")
                return
        print(f"  {Color.RED}[ERROR] Profile '{name}' not found.{Color.RESET}")
    elif cmd == "current":
        active = get_active_account_name()
        cred = CredentialStore.read()
        email = extract_email(cred) if cred else "(none)"
        print(f"\n  Active Profile : {active or '(none)'}")
        print(f"  Active Email   : {email}")
        cmd_quota()
    else:
        cmd_help()

if __name__ == "__main__":
    main()
