def cmd_vault(action: str, repo: str = "agy-rig-vault"):
    target_repo = repo or "agy-rig-vault"
    # Check gh
    res = subprocess.run(["gh", "auth", "status"], capture_output=True, text=True)
    if res.returncode != 0:
        print(f"  {Color.RED}[ERROR] GitHub CLI ('gh') is not authenticated. Run 'gh auth login' first.{Color.RESET}")
        return

    import getpass
    if action in ["backup", "export"]:
        passphrase = getpass.getpass("  Enter Master Passphrase to encrypt vault: ")
        if len(passphrase) < 6:
            print(f"  {Color.RED}[ERROR] Passphrase must be at least 6 characters.{Color.RESET}")
            return
        pass2 = getpass.getpass("  Confirm Master Passphrase: ")
        if passphrase != pass2:
            print(f"  {Color.RED}[ERROR] Passphrase confirmation does not match.{Color.RESET}")
            return

        accounts = list_saved_accounts()
        if not accounts:
            print(f"  {Color.RED}[ERROR] No saved accounts found to backup.{Color.RESET}")
            return

        print(f"\n  {Color.CYAN}[1/3] Encrypting {len(accounts)} accounts with AES-256 + HMAC-SHA256...{Color.RESET}")
        payload = {
            "version": "1.0",
            "timestamp": datetime.now().strftime("%Y-%m-%d %H:%M:%S"),
            "accounts": accounts
        }
        enc_vault = AgyCrypto.encrypt_vault(json.dumps(payload), passphrase)

        manifest = {
            "version": "1.0",
            "timestamp": datetime.now().strftime("%Y-%m-%d %H:%M:%S"),
            "total_accounts": len(accounts),
            "account_names": [a["name"] for a in accounts],
            "cipher": "AES-256-CBC-PBKDF2-HMAC-SHA256"
        }

        import tempfile
        import shutil
        temp_dir = tempfile.mkdtemp(prefix="agyrig-vault-")
        try:
            print(f"  {Color.CYAN}[2/3] Checking/creating private repository '{target_repo}'...{Color.RESET}")
            chk = subprocess.run(["gh", "repo", "view", target_repo], capture_output=True)
            if chk.returncode != 0:
                subprocess.run(["gh", "repo", "create", target_repo, "--private", "--description", "AGY RIG Encrypted Credential Vault"], check=True)

            print(f"  {Color.CYAN}[3/3] Committing and pushing encrypted vault to GitHub...{Color.RESET}")
            subprocess.run(["git", "init", "-b", "main"], cwd=temp_dir, capture_output=True, check=True)
            with open(os.path.join(temp_dir, "vault.enc"), "w", encoding="utf-8") as fp:
                fp.write(enc_vault)
            with open(os.path.join(temp_dir, "manifest.json"), "w", encoding="utf-8") as fp:
